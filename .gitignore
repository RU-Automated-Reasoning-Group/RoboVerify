# Python
*pyc
__pycache__/
myenv/*

# Tooling state
.claude/worktrees/
tmux-*.log

# ---------------------------------------------------------------------------
# Experiment output: regenerable, and large enough that committing it would
# permanently bloat the repository (these directories currently hold ~190MB
# against a 19MB .git). Patterns are deliberately specific rather than blanket
# *.png / *.npy, because 14 .png asset files are legitimately tracked.
# ---------------------------------------------------------------------------

# Instrumented run directories (synthesis/experiment/run_logger.py)
roboverify/runs/

# MCMC search and rollout output
roboverify/MCMC_results*
roboverify/random_rollouts_after_*
roboverify/demo_splits_with_*

# Rendered frames, plots and videos
roboverify/images
roboverify/synthesis/images
roboverify/api_test/
roboverify/demo_images/
roboverify/final_plots/
final_plots/
roboverify/decision_tree*.png
roboverify/last.png
roboverify/synthesis/entry/envs.png
roboverify/*.mp4

# Result bundles
roboverify/final_results/
roboverify/final_results_submission/

# Trained models
roboverify/synthesis/trained

# Scratch MuJoCo XML written by the environment at runtime
roboverify/synthesis/environment/cee_us_env/fpp_construction/assets/fetch/tmp*.xml
